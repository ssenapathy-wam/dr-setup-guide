# ============================================================================
# Confluent Cloud Configuration
# ============================================================================
CONFLUENT_PROD_ENV_ID=env-prod
CONFLUENT_DR_ENV_ID=env-dr
CONFLUENT_PROD_CLUSTER_ID=lkc-prod
CONFLUENT_DR_CLUSTER_ID=lkc-dr
CONFLUENT_PROD_API_KEY=your_api_key_here
CONFLUENT_PROD_API_SECRET=your_api_secret_here
CONFLUENT_DR_API_KEY=your_api_key_here
CONFLUENT_DR_API_SECRET=your_api_secret_here
CONFLUENT_PROD_BOOTSTRAP=pkc-prod.region.provider.confluent.cloud:9092
CONFLUENT_DR_BOOTSTRAP=pkc-dr.region.provider.confluent.cloud:9092

# ============================================================================
# Schema Registry Configuration
# ============================================================================
CONFLUENT_SCHEMA_REGISTRY_PROD_URL=https://psrc-prod.region.provider.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_PROD_USER=your_sr_user
CONFLUENT_SCHEMA_REGISTRY_PROD_PASSWORD=your_sr_password
CONFLUENT_SCHEMA_REGISTRY_DR_URL=https://psrc-dr.region.provider.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_DR_USER=your_sr_user
CONFLUENT_SCHEMA_REGISTRY_DR_PASSWORD=your_sr_password

# Schema Exporter Configuration
EXPORTER_NAME=prod-to-dr-exporter
EXPORTER_CONTEXT_TYPE=CUSTOM
EXPORTER_CONTEXT_NAME=prod
EXPORTER_SUBJECTS=:*:

# Cluster Link Configuration
CLUSTER_LINK_NAME=prod-to-dr

# Topics to Mirror (comma-separated)
MIRROR_TOPICS=topic1,topic2,topic3

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=us-west-2
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
EKS_CLUSTER_NAME=es-wt-eks-cluster-nonprod

# ============================================================================
# Kubernetes Configuration
# ============================================================================
K8S_NAMESPACE=operator-uat
K8S_SECRET_NAME=secret-kafka
K8S_CONNECTOR_LABEL=app=connectors
K8S_ADDITIONAL_SECRETS=secret1,secret2

# ============================================================================
# Application Configuration
# ============================================================================
DRY_RUN=false
DRY_RUN_VERBOSE=true
MAX_RETRIES=3
RETRY_DELAY=5
BACKOFF_MULTIPLIER=2.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/dr_setup.log

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_CLUSTER_LINK=true
ENABLE_TOPIC_MIRRORING=true
ENABLE_SCHEMA_SYNC=true
ENABLE_TOPIC_PROMOTION=true
ENABLE_EKS_SETUP=true
ENABLE_SECRET_UPDATE=true

# ============================================================================
# Timeouts (in seconds)
# ============================================================================
COMMAND_TIMEOUT=300
API_TIMEOUT=30
CLUSTER_LINK_TIMEOUT=600

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# EMAIL_RECIPIENT=your-email@example.com
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
